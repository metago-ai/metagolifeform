{
  "name": "reasoning_chain",
  "description": "推理链（49 个算法）。根据 operation 参数选择族内具体算法。operation 可选算法名关键词（如 cosine/euclidean/pearson）。不指定 operation 时执行族内首个算法。",
  "arguments": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "deductiveReasoning",
          "inductiveReasoning",
          "abductiveReasoning",
          "analogicalReasoning",
          "causalReasoning",
          "counterfactualReasoning",
          "modalReasoning",
          "temporalReasoning",
          "spatialReasoning",
          "quantitativeReasoning",
          "qualitativeReasoning",
          "fuzzyReasoning",
          "probabilisticReasoning",
          "heuristicReasoning",
          "forwardChaining",
          "fipoReasoning",
          "causalReasoning",
          "counterfactualReasoning",
          "multiStepReasoningChain",
          "abductiveReasoning",
          "deductiveReasoning",
          "inductiveReasoning",
          "analogicalReasoning",
          "modalReasoning",
          "probabilisticReasoning",
          "fuzzyReasoning",
          "temporalReasoning",
          "spatialReasoning",
          "metaReasoning",
          "reasoningChainValidate",
          "reasoningPathSearch",
          "reasoningConflictResolve",
          "hypothesisGenerate",
          "reasoningOptimize",
          "reasoningComprehensiveAssessment",
          "FIPO 四阶段推理",
          "演绎推理方法",
          "归纳推理方法",
          "类比推理方法",
          "因果推理方法",
          "反事实推理方法",
          "溯因推理方法",
          "模糊推理方法",
          "概率推理方法",
          "多步推理方法",
          "链式推理机制",
          "树状推理方法",
          "图谱推理方法",
          "量子推理模型"
        ],
        "description": "族内算法选择：传算法名（如 deductiveReasoning）。路由规则是按名称/ID/关键词子串匹配 族 REASONING 的 49 个算法，匹配不上则用族内第一个。"
      },
      "input": {
        "type": [
          "object",
          "array",
          "string",
          "number",
          "boolean"
        ],
        "description": "传给所选算法的**原始参数**，形状随 operation 变化：\n  · 多参算法 → 位置数组 [p1, p2, ...]\n  · 单参算法要对象时 → 对象 {…}\n  · 单参算法要标量/数组时 → 直接传该值\n具体见所选算法的 inputSchema（可用 get_algorithm_info 查）。"
      }
    },
    "required": [
      "operation",
      "input"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#",
    "examples": [
      {
        "operation": "deductiveReasoning",
        "input": {
          "premises": [
            {
              "statement": "A",
              "truth": 1,
              "confidence": 0.9
            },
            {
              "statement": "A→B",
              "truth": 1,
              "confidence": 0.95
            }
          ],
          "rules": [
            {
              "premises": [
                "A",
                "A→B"
              ],
              "conclusion": "B",
              "confidence": 0.98
            }
          ]
        }
      }
    ]
  }
}