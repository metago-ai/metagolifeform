{
  "name": "decision_decide",
  "description": "决策制定（48 个算法）。根据 operation 参数选择族内具体算法。operation 可选算法名关键词（如 cosine/euclidean/pearson）。不指定 operation 时执行族内首个算法。",
  "arguments": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "intentVerification",
          "intentLineageTrace",
          "semanticOutputGate",
          "contentIntegrityCheck",
          "decisionLockGate",
          "decisionAudit",
          "decisionRollback",
          "decisionVeto",
          "decisionPriority",
          "decisionConflict",
          "decisionQuorum",
          "decisionConsensus",
          "decisionThreshold",
          "decisionWeight",
          "decisionTraceability",
          "intentVerificationLayer",
          "intentLineageTrace",
          "semanticOutputGate",
          "contentIntegrityCheck",
          "decisionLockExecute",
          "decisionTreeBuild",
          "decisionTreeTraverse",
          "decisionRiskAssess",
          "decisionRollback",
          "decisionAuditLog",
          "decisionWeightCalculate",
          "decisionConsistencyCheck",
          "decisionPrioritize",
          "decisionSimulate",
          "decisionAuthorize",
          "decisionTimeoutHandle",
          "decisionConflictResolve",
          "decisionReversibility",
          "decisionPerformanceImpact",
          "decisionComprehensiveAssessment",
          "决策锁强制校验",
          "意图验证机制",
          "意图谱系追踪",
          "语义输出门",
          "内容完整性校验",
          "决策回溯机制",
          "决策评估方法",
          "决策风险分析",
          "决策权衡方法",
          "决策收敛机制",
          "决策分叉管理",
          "决策记忆机制",
          "决策进化机制"
        ],
        "description": "族内算法选择：传算法名（如 intentVerification）。路由规则是按名称/ID/关键词子串匹配 族 DECISION 的 48 个算法，匹配不上则用族内第一个。"
      },
      "input": {
        "type": [
          "object",
          "array",
          "string",
          "number",
          "boolean"
        ],
        "description": "传给所选算法的**原始参数**，形状随 operation 变化：\n  · 多参算法 → 位置数组 [p1, p2, ...]\n  · 单参算法要对象时 → 对象 {…}\n  · 单参算法要标量/数组时 → 直接传该值\n具体见所选算法的 inputSchema（可用 get_algorithm_info 查）。"
      }
    },
    "required": [
      "operation",
      "input"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#",
    "examples": [
      {
        "operation": "intentVerification",
        "input": {
          "intent": [
            1,
            2,
            3
          ],
          "rules": [
            {
              "pattern": "s0",
              "required": 1
            },
            {
              "pattern": "s1",
              "required": 1
            },
            {
              "pattern": "s2",
              "required": 1
            }
          ]
        }
      }
    ]
  }
}