{
  "name": "learning_learn",
  "description": "学习训练（49 个算法）。根据 operation 参数选择族内具体算法。operation 可选算法名关键词（如 cosine/euclidean/pearson）。不指定 operation 时执行族内首个算法。",
  "arguments": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "supervisedLearn",
          "unsupervisedLearn",
          "reinforcementLearn",
          "transferLearning",
          "activeLearning",
          "passiveLearning",
          "associativeLearning",
          "habituation",
          "sensitization",
          "conditioning",
          "observationalLearning",
          "experientialLearning",
          "socialLearning",
          "metaLearning",
          "curriculumLearning",
          "patternExtract",
          "skillGenerate",
          "feedbackLoop",
          "adaptiveLearningRate",
          "knowledgeTransfer",
          "learningCurve",
          "experienceReplay",
          "reinforcementSignal",
          "curriculumLearning",
          "knowledgeGraphBuild",
          "learningStrategySelect",
          "overfittingDetect",
          "modelDistill",
          "activeLearningSelect",
          "onlineLearningUpdate",
          "ensembleLearning",
          "gradientCalculate",
          "learningAssess",
          "knowledgeConsolidate",
          "learningComprehensiveAssessment",
          "经验学习方法",
          "反馈学习机制",
          "强化学习框架",
          "监督学习方法",
          "无监督学习方法",
          "迁移学习方法",
          "元学习方法",
          "在线学习方法",
          "增量学习方法",
          "联邦学习方法",
          "主动学习方法",
          "课程学习方法",
          "多任务学习方法",
          "持续学习框架"
        ],
        "description": "族内算法选择：传算法名（如 supervisedLearn）。路由规则是按名称/ID/关键词子串匹配 族 LEARNING 的 49 个算法，匹配不上则用族内第一个。"
      },
      "input": {
        "type": [
          "object",
          "array",
          "string",
          "number",
          "boolean"
        ],
        "description": "传给所选算法的**原始参数**，形状随 operation 变化：\n  · 多参算法 → 位置数组 [p1, p2, ...]\n  · 单参算法要对象时 → 对象 {…}\n  · 单参算法要标量/数组时 → 直接传该值\n具体见所选算法的 inputSchema（可用 get_algorithm_info 查）。"
      }
    },
    "required": [
      "operation",
      "input"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#",
    "examples": [
      {
        "operation": "supervisedLearn",
        "input": {
          "samples": [
            {
              "features": [
                1,
                0
              ],
              "label": 1
            },
            {
              "features": [
                0,
                1
              ],
              "label": 0
            },
            {
              "features": [
                1,
                1
              ],
              "label": 1
            }
          ],
          "learningRate": 0.1,
          "epochs": 100
        }
      }
    ]
  }
}