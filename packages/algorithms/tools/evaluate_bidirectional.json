{
  "name": "evaluate_bidirectional",
  "description": "双向耦生度评估。适用：分析双向关系强度。返回 {forward, backward, symmetric}。（算法 ID: ALG_T1_C_015）",
  "arguments": {
    "type": "object",
    "properties": {
      "forward": {
        "type": "array",
        "description": "正向样本数组，如 [0.8,0.6,0.9]",
        "examples": [
          [
            0.8,
            0.6,
            0.9
          ]
        ]
      },
      "backward": {
        "type": "array",
        "description": "反向样本数组，如 [0.7,0.65,0.8]",
        "examples": [
          [
            0.7,
            0.65,
            0.8
          ]
        ]
      }
    },
    "required": [
      "forward",
      "backward"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#",
    "examples": [
      {
        "forward": [
          0.8,
          0.6,
          0.9
        ],
        "backward": [
          0.7,
          0.65,
          0.8
        ]
      }
    ]
  }
}