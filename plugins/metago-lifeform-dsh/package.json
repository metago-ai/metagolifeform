{
  "name": "metago-lifeform-dsh",
  "version": "1.0.0",
  "private": true,
  "description": "MetaGO Intelligent Lifeform · 元构生命体运行时控制层：元构超级智能生命体模式（Agent preset）+ 元构控制台原生界面 + 状态工具，作为 DSH 原生插件运行。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./patch/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/status.js",
    "lib/client.js",
    "lib/client.js.map",
    "patch/cordis.patch.yml",
    "patch/preset.patch.yml",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "external": [
        "react"
      ]
    },
    "bundle": {
      "patch": [
        "./patch/cordis.patch.yml",
        "./patch/preset.patch.yml"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "license": "MIT"
}
