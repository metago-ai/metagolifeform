{
  "name": "idea_generate",
  "description": "创意生成（20 个算法）。根据 operation 参数选择族内具体算法。operation 可选算法名关键词（如 cosine/euclidean/pearson）。不指定 operation 时执行族内首个算法。",
  "arguments": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "evaluateIdeaGeneration",
          "analyzeIdeaAssociations",
          "traceIdeaEvolution",
          "combineIdeas",
          "detectIdeaDivergence",
          "rankIdeas",
          "filterIdeas",
          "mutateIdea",
          "crossoverIdeas",
          "selectEliteIdeas",
          "assessIdeaDiversity",
          "detectIdeaConvergence",
          "identifyInspirationSource",
          "assessIdeaImpactScope",
          "analyzeIdeaFeasibility",
          "assessIdeaNovelty",
          "planIdeaImplementation",
          "assessIdeaRisk",
          "integrateIdeaFeedback",
          "comprehensiveIdeaAssessment"
        ],
        "description": "族内算法选择：传算法名（如 evaluateIdeaGeneration）。路由规则是按名称/ID/关键词子串匹配 族 IDEA 的 20 个算法，匹配不上则用族内第一个。"
      },
      "input": {
        "type": [
          "object",
          "array",
          "string",
          "number",
          "boolean"
        ],
        "description": "传给所选算法的**原始参数**，形状随 operation 变化：\n  · 多参算法 → 位置数组 [p1, p2, ...]\n  · 单参算法要对象时 → 对象 {…}\n  · 单参算法要标量/数组时 → 直接传该值\n具体见所选算法的 inputSchema（可用 get_algorithm_info 查）。"
      }
    },
    "required": [
      "operation",
      "input"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#",
    "examples": [
      {
        "operation": "evaluateIdeaGeneration",
        "input": {
          "idea": {
            "novelty": 1,
            "feasibility": 2,
            "impact": 3
          },
          "criteria": {
            "novelty": 1,
            "feasibility": 2,
            "impact": 3
          }
        }
      }
    ]
  }
}