{
  "name": "search_algorithms",
  "description": "按关键词搜索算法（在名称/描述/关键词中匹配）。返回匹配的算法列表。",
  "arguments": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "搜索关键词"
      },
      "limit": {
        "type": "number",
        "description": "返回数量限制，默认 20"
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}