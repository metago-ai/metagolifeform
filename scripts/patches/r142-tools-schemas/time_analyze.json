{
  "name": "time_analyze",
  "description": "时间分析（49 个算法）。根据 operation 参数选择族内具体算法。operation 可选算法名关键词（如 cosine/euclidean/pearson）。不指定 operation 时执行族内首个算法。",
  "arguments": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "timeSeriesForecast",
          "temporalPatternRecognition",
          "timeArrowDetermination",
          "spatialDistance",
          "spatiotemporalInterpolation",
          "periodicityDetection",
          "trendAnalysis",
          "seasonalDecomposition",
          "timeWindowAggregation",
          "spatiotemporalClustering",
          "temporalAnomalyDetection",
          "timeDecayMemory",
          "causalTemporalInference",
          "temporalConsistencyCheck",
          "spatiotemporalPathOptimization",
          "aggregateTimeWindow",
          "timeSeriesTrend",
          "detectSeasonality",
          "detectTimeAnomaly",
          "analyzeTimeInterval",
          "forecastTimeSeries",
          "smoothTimeSeries",
          "diffTimeSeries",
          "autocorrelation",
          "slidingWindow",
          "decomposeTimeSeries",
          "resampleTimeSeries",
          "alignTimestamps",
          "normalizeTimeSeries",
          "crossCorrelation",
          "detectPeriod",
          "fillMissingTime",
          "truncateTimeSeries",
          "timeSeriesStatistics",
          "comprehensiveTimeAssessment",
          "时间衰减模型",
          "时间序列分析",
          "时间窗口机制",
          "时间戳管理",
          "时间同步方法",
          "时间漂移检测",
          "时间预算管理",
          "时间优化策略",
          "时间感知机制",
          "时间记忆机制",
          "时间推理方法",
          "时间冲突管理",
          "时间平衡策略",
          "时间进化机制"
        ],
        "description": "族内算法选择：传算法名（如 timeSeriesForecast）。路由规则是按名称/ID/关键词子串匹配 族 TIME 的 49 个算法，匹配不上则用族内第一个。"
      },
      "input": {
        "type": [
          "object",
          "array",
          "string",
          "number",
          "boolean"
        ],
        "description": "传给所选算法的**原始参数**，形状随 operation 变化：\n  · 多参算法 → 位置数组 [p1, p2, ...]\n  · 单参算法要对象时 → 对象 {…}\n  · 单参算法要标量/数组时 → 直接传该值\n具体见所选算法的 inputSchema（可用 get_algorithm_info 查）。"
      }
    },
    "required": [
      "operation",
      "input"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#",
    "examples": [
      {
        "operation": "timeSeriesForecast",
        "input": {
          "series": [
            {
              "timestamp": 1,
              "value": 1
            },
            {
              "timestamp": 2,
              "value": 1
            },
            {
              "timestamp": 3,
              "value": 1
            }
          ],
          "horizon": 0.6
        }
      }
    ]
  }
}