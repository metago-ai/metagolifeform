{
  "name": "identify_weak_pairs",
  "description": "识别弱耦生对。适用：发现需要加强的关系。返回弱对列表。（算法 ID: ALG_T1_C_017）",
  "arguments": {
    "type": "object",
    "properties": {
      "pairs": {
        "type": "array",
        "description": "耦合矩阵（二维系数组 [[0,0.2],[0.2,0]]）或 {size,matrix,labels}",
        "examples": [
          [
            [
              0,
              0.2
            ],
            [
              0.2,
              0
            ]
          ]
        ]
      },
      "threshold": {
        "type": "number",
        "description": "阈值"
      }
    },
    "required": [
      "pairs",
      "threshold"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#",
    "examples": [
      {
        "pairs": [
          [
            0,
            0.2,
            0.05
          ],
          [
            0.2,
            0,
            0.9
          ],
          [
            0.05,
            0.9,
            0
          ]
        ],
        "threshold": 0.3
      }
    ]
  }
}