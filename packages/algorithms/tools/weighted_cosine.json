  "arguments": {
    "type": "object",
    "properties": {
      "a": {
        "type": "array",
        "description": "向量 A"
      },
      "b": {
        "type": "array",
        "description": "向量 B"
      },
      "weights": {
        "type": "array",
        "description": "权重向量"
      }
    },
    "required": [
      "a",
      "b",
      "weights"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#",
    "examples": [
      {
        "a": [
          1,
          2,
          3
        ],
        "b": [
          2,
          4,
          6
        ],
        "weights": [
          1,
          2,
          1
        ]
      }
    ]
  }
}