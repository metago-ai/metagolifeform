{
  "name": "coupling_clustering",
  "description": "耦生聚类分析。适用：关系网络分组。返回聚类结果。（算法 ID: ALG_T1_C_025）",
  "arguments": {
    "type": "object",
    "properties": {
      "entities": {
        "type": "array",
        "description": "耦合矩阵（二维系数组 [[0,0.9],[0.9,0]]），或实体标签数组",
        "examples": [
          [
            [
              0,
              0.9
            ],
            [
              0.9,
              0
            ]
          ]
        ]
      },
      "k": {
        "type": "number",
        "description": "聚类数"
      }
    },
    "required": [
      "entities",
      "k"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#",
    "examples": [
      {
        "entities": [
          [
            0,
            0.9,
            0.2
          ],
          [
            0.9,
            0,
            0.1
          ],
          [
            0.2,
            0.1,
            0
          ]
        ],
        "k": 2
      }
    ]
  }
}