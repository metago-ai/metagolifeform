{
  "$schema": "https://metago.life/schemas/completeness.config.schema.json",
  "version": "1.0.0",
  "target": {
    "type": "architecture",
    "doc": "docs/Agent-Native-Workbench-架构方案文档.md",
    "version": "V1.4.0",
    "minSections": 10
  },
  "baselines": {
    "dirs": [],
    "enabled": ["B1-framework", "B2-industry-standard", "B3-protocols", "B4-self-dissection", "B5-metago-law", "B6-competitors", "B7-user-custom"]
  },
  "enforcement": {
    "level": "hard",
    "forbiddenDeclarations": ["绝对完整", "100%完美", "100%完整", "不会再缺", "不可能有遗漏", "绝对100%"],
    "requireReportOnComplete": true,
    "hooks": {
      "enabled": true,
      "platforms": ["zcode", "claude-code"],
      "preToolUseGuard": true,
      "stopVerify": true
    }
  },
  "radar": {
    "enabled": true,
    "scanIntervalDays": 7
  },
  "gaps": {
    "file": "completeness-gaps.json"
  }
}
