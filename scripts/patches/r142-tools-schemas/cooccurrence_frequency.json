{
  "name": "cooccurrence_frequency",
  "description": "共现频率计算。适用：关联分析、推荐。返回频率值。（算法 ID: ALG_T1_C_013）",
  "arguments": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "description": "序列集合：二维数组 [[\"a\",\"b\",\"c\"],[\"a\",\"b\"]]（每个子数组是一条序列）"
      },
      "item1": {
        "type": "string",
        "description": "**要计算共现的第一个项**，如 \"a\"（缺省时从 items 推导为第一个不同项）"
      },
      "item2": {
        "type": "string",
        "description": "**要计算共现的第二个项**，如 \"b\"（缺省时从 items 推导为第二个不同项）"
      }
    },
    "required": [
      "items"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#",
    "examples": [
      {
        "items": [
          [
            "a",
            "b",
            "c"
          ],
          [
            "a",
            "b"
          ],
          [
            "a"
          ],
          [
            "b"
          ]
        ],
        "item1": "a",
        "item2": "b"
      }
    ]
  }
}