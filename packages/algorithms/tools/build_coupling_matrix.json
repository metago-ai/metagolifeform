        "description": "关系列表"
      }
    },
    "required": [
      "entities",
      "relations"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#",
    "examples": [
      {
        "entities": [
          {
            "id": "A"
          },
          {
            "id": "B"
          },
          {
            "id": "C"
          }
        ],
        "relations": [
          {
            "from": "A",
            "to": "B",
            "weight": 0.8
          },
          {
            "from": "B",
            "to": "C",
            "weight": 0.6
          }
        ]
      }
    ]
  }
}