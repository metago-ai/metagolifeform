          "frequencySpectralDensity",
          "frequencyPhaseDiff",
          "frequencyModulate",
          "frequencyFilter",
          "frequencyPeriodDetect",
          "frequencySweep",
          "frequencySynchronize",
          "frequencyJitterAnalyze",
          "frequencyDecay",
          "frequencyAmplify",
          "frequencyMix",
          "frequencyThresholdAlert",
          "frequencyCalibrate",
          "frequencyStatistics",
          "frequencyComprehensiveAssessment",
