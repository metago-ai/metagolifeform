{
  "name": "negentropy_measure",
  "description": "负熵测量（49 个算法）。根据 operation 参数选择族内具体算法。operation 可选算法名关键词（如 cosine/euclidean/pearson）。不指定 operation 时执行族内首个算法。",
  "arguments": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "computeEntropy",
          "computeNegentropy",
          "entropyDelta",
          "orderDegree",
          "complexityMeasure",
          "informationDensity",
          "mutualInformation",
          "conditionalEntropy",
          "relativeEntropy",
          "crossEntropy",
          "entropyRate",
          "entropyProduction",
          "entropyExport",
          "entropyBalance",
          "entropyMonitor",
          "shannonEntropy",
          "negentropyCalculate",
          "entropyDeltaCalculate",
          "systemOrderAssess",
          "negentropyContributionAssess",
          "entropyIncreaseDetect",
          "thermodynamicEntropyApprox",
          "informationEntropyFlow",
          "entropyThresholdAlert",
          "systemComplexityAssess",
          "negentropyInjectStrategy",
          "entropyBalance",
          "entropySourceAnalyze",
          "entropySteadyStateDetect",
          "entropyPredict",
          "entropyAudit",
          "negentropyLedgerRecord",
          "entropyOptimizationSuggest",
          "entropyReportGenerate",
          "negentropyComprehensiveAssessment",
          "负熵监测机制",
          "熵增检测方法",
          "熵减策略库",
          "系统有序度量化",
          "熵变计算方法",
          "社会责任评估",
          "熵流分析方法",
          "熵平衡策略",
          "熵阈值设计",
          "稳态监测机制",
          "熵溯源方法",
          "熵审计方法",
          "熵优化策略",
          "熵进化机制"
        ],
        "description": "族内算法选择：传算法名（如 computeEntropy）。路由规则是按名称/ID/关键词子串匹配 族 NEGENTROPY 的 49 个算法，匹配不上则用族内第一个。"
      },
      "input": {
        "type": [
          "object",
          "array",
          "string",
          "number",
          "boolean"
        ],
        "description": "传给所选算法的**原始参数**，形状随 operation 变化：\n  · 多参算法 → 位置数组 [p1, p2, ...]\n  · 单参算法要对象时 → 对象 {…}\n  · 单参算法要标量/数组时 → 直接传该值\n具体见所选算法的 inputSchema（可用 get_algorithm_info 查）。"
      }
    },
    "required": [
      "operation",
      "input"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#",
    "examples": [
      {
        "operation": "computeEntropy",
        "input": [
          0.5,
          0.8,
          0.2,
          0.9
        ]
      }
    ]
  }
}