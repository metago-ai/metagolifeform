{
  "name": "security_assess",
  "description": "安全评估（48 个算法）。根据 operation 参数选择族内具体算法。operation 可选算法名关键词（如 cosine/euclidean/pearson）。不指定 operation 时执行族内首个算法。",
  "arguments": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "vulnerabilityScan",
          "threatAssessment",
          "riskScoring",
          "accessControl",
          "permissionCheck",
          "authenticationVerify",
          "authorizationCheck",
          "dataEncrypt",
          "sensitiveDataDetection",
          "injectionPrevention",
          "xssPrevention",
          "csrfPrevention",
          "rateLimit",
          "auditLog",
          "securityPosture",
          "threatModeling",
          "permissionVerify",
          "sqlInjectionDetect",
          "xssDetect",
          "csrfTokenVerify",
          "authStrengthAssess",
          "privilegeEscalationDetect",
          "anomalyAccessDetect",
          "rateLimitCheck",
          "encryptionStrengthVerify",
          "auditLogGenerate",
          "securityPolicyAssess",
          "vulnerabilityAssess",
          "intrusionDetect",
          "dataLeakDetect",
          "ddosDetect",
          "securityIncidentResponse",
          "complianceCheck",
          "passwordHashVerify",
          "securityComprehensiveAssessment",
          "合规主动检查",
          "法律优先原则",
          "安全审计方法",
          "漏洞扫描技术",
          "渗透测试方法",
          "权限边界控制",
          "注入防护机制",
          "XSS 防御机制",
          "越权访问检测",
          "敏感信息保护",
          "依赖安全审计",
          "供应链安全",
          "安全事件响应"
        ],
        "description": "族内算法选择：传算法名（如 vulnerabilityScan）。路由规则是按名称/ID/关键词子串匹配 族 SECURITY 的 48 个算法，匹配不上则用族内第一个。"
      },
      "input": {
        "type": [
          "object",
          "array",
          "string",
          "number",
          "boolean"
        ],
        "description": "传给所选算法的**原始参数**，形状随 operation 变化：\n  · 多参算法 → 位置数组 [p1, p2, ...]\n  · 单参算法要对象时 → 对象 {…}\n  · 单参算法要标量/数组时 → 直接传该值\n具体见所选算法的 inputSchema（可用 get_algorithm_info 查）。"
      }
    },
    "required": [
      "operation",
      "input"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#",
    "examples": [
      {
        "operation": "vulnerabilityScan",
        "input": {
          "components": [
            {
              "name": "s0",
              "version": 1
            },
            {
              "name": "s1",
              "version": 1
            },
            {
              "name": "s2",
              "version": 1
            }
          ],
          "knownVulns": [
            {
              "component": "lodash",
              "versionRange": "<4.17.21",
              "severity": "high",
              "cvss": 7.5
            },
            {
              "component": "express",
              "versionRange": "<4.18.0",
              "severity": "medium",
              "cvss": 5.3
            }
          ]
        }
      }
    ]
  }
}