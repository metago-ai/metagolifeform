{
  "name": "evolution_evolve",
  "description": "进化计算（50 个算法）。根据 operation 参数选择族内具体算法。operation 可选算法名关键词（如 cosine/euclidean/pearson）。不指定 operation 时执行族内首个算法。",
  "arguments": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "detectBoundary",
          "analyzeGap",
          "selfGenerate",
          "verifyEvolution",
          "recursiveEvolve",
          "evolutionCycle",
          "evolutionRate",
          "evolutionDepth",
          "evolutionBreadth",
          "evolutionFitness",
          "evolutionPressure",
          "evolutionMutation",
          "evolutionSelection",
          "evolutionCrossover",
          "evolutionLineage",
          "evolutionFiveStageCycle",
          "evolutionBoundarySense",
          "evolutionGapAnalysis",
          "evolutionSelfGenerate",
          "evolutionVerify",
          "evolutionRecurseTrigger",
          "evolutionFitness",
          "evolutionHistoryTrace",
          "evolutionAccelerate",
          "evolutionStagnationDetect",
          "evolutionPathPlanning",
          "evolutionDiversityMaintain",
          "evolutionAssessmentReport",
          "evolutionThresholdAdapt",
          "evolutionRollback",
          "evolutionEfficiency",
          "evolutionStressTest",
          "evolutionCoEvolve",
          "evolutionGoalAlign",
          "evolutionComprehensiveAssessment",
          "边界感知机制",
          "差距分析方法",
          "自生成机制",
          "进化验证方法",
          "进化递归机制",
          "元进化五阶段循环",
          "能力边界建模",
          "进化引擎架构",
          "进化指标体系",
          "进化路径规划",
          "进化回溯机制",
          "进化收敛分析",
          "进化分叉机制",
          "进化稳态维持",
          "进化涌现现象"
        ],
        "description": "族内算法选择：传算法名（如 detectBoundary）。路由规则是按名称/ID/关键词子串匹配 族 EVOLUTION 的 50 个算法，匹配不上则用族内第一个。"
      },
      "input": {
        "type": [
          "object",
          "array",
          "string",
          "number",
          "boolean"
        ],
        "description": "传给所选算法的**原始参数**，形状随 operation 变化：\n  · 多参算法 → 位置数组 [p1, p2, ...]\n  · 单参算法要对象时 → 对象 {…}\n  · 单参算法要标量/数组时 → 直接传该值\n具体见所选算法的 inputSchema（可用 get_algorithm_info 查）。"
      }
    },
    "required": [
      "operation",
      "input"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#",
    "examples": [
      {
        "operation": "detectBoundary",
        "input": [
          0.5,
          0.8,
          0.2,
          0.9
        ]
      }
    ]
  }
}