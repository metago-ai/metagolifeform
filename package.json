{
  "name": "metago-lifeform",
  "version": "37.0.0",
  "description": "元构·智能生命体（MetaGO Intelligent Lifeform）— 让智能体从工具升级为守规矩、会进化、可追溯、能闭环的生命体。112 技能 · 35 专家子智能体 · 核心 MCP 112 工具（55+57）/ 927 算法（T3 227 条已工程化为可执行实现） · 38 条核心公理 · Engine V2.1.4（KMWI 四层记忆 + 元进化五阶段 + 技能智能生成）· 决策锁四道关卡 · 七层验证 + L8 缺陷猎杀 + L9 对抗式审查 + UDGK 通用交付门禁。一键适配 11 平台形态 + 四格式插件包。MIT 开源。",
  "main": "core/METAGO_CORE.md",
  "bin": {
    "metago-lifeform": "scripts/cli.js"
  },
  "scripts": {
    "install:trae": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1",
    "install:trae:bash": "bash scripts/install.sh",
    "uninstall:trae": "powershell -ExecutionPolicy Bypass -File scripts/uninstall.ps1",
    "verify": "powershell -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "verify:delivery": "node scripts/pre-delivery-verify.cjs --project=lifeform",
    "verify:terminology": "node scripts/test-v41-terminology.cjs",
    "verify:memory": "node scripts/memory-guard.cjs",
    "list:skills": "powershell -Command \"Get-ChildItem skills -Directory | Select-Object Name\"",
    "build:mcp": "cd packages/mcp-server && npm run build",
    "start:mcp": "cd packages/mcp-server && npm start",
    "demo": "node packages/demo/killer-demo.mjs",
    "dashboard": "node packages/dashboard/server.mjs",
    "verify:ci": "node scripts/ci-version-gate.cjs"
  },
  "workspaces": [
    "packages/*"
  ],
