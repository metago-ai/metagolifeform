{
  "name": "creation_create",
  "description": "创造生成（50 个算法）。根据 operation 参数选择族内具体算法。operation 可选算法名关键词（如 cosine/euclidean/pearson）。不指定 operation 时执行族内首个算法。",
  "arguments": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "generateNovelIdea",
          "constraintAlignment",
          "noveltyScore",
          "creationTrigger",
          "creationPrimitive",
          "creationIntegrityCheck",
          "historyNegentropy",
          "creationGovernor",
          "divergentGeneration",
          "convergentRefinement",
          "creationMutation",
          "creationRecombination",
          "creationSelection",
          "creationFitness",
          "creationLineage",
          "creationTriggerEvaluate",
          "creationPrimitiveSynthesize",
          "creationConstraintAlign",
          "creationIntegrityCheck",
          "creationNoveltyAssess",
          "creationUtilityAssess",
          "creationFeasibility",
          "creationIterateOptimize",
          "creationPathSelect",
          "creationRiskAssess",
          "creationProvenance",
          "creationImpactAssess",
          "creationSynergize",
          "creationDecayMonitor",
          "creationEvolutionTrace",
          "creationValidationTest",
          "creationOptimizationDirection",
          "creationCombinatorialControl",
          "creationQualityGrade",
          "creationComprehensiveAssessment",
          "元创造原理",
          "内生创造机制",
          "零到一创造路径",
          "创造频率调控",
          "创造回路设计",
          "创造验证方法",
          "创造递归机制",
          "创造边界探索",
          "创造跃迁现象",
          "创造收敛策略",
          "创造发散方法",
          "创造评估框架",
          "创造溯源链",
          "创造记忆机制",
          "创造进化律"
        ],
        "description": "族内算法选择：传算法名（如 generateNovelIdea）。路由规则是按名称/ID/关键词子串匹配 族 CREATION 的 50 个算法，匹配不上则用族内第一个。"
      },
      "input": {
        "type": [
          "object",
          "array",
          "string",
          "number",
          "boolean"
        ],
        "description": "传给所选算法的**原始参数**，形状随 operation 变化：\n  · 多参算法 → 位置数组 [p1, p2, ...]\n  · 单参算法要对象时 → 对象 {…}\n  · 单参算法要标量/数组时 → 直接传该值\n具体见所选算法的 inputSchema（可用 get_algorithm_info 查）。"
      }
    },
    "required": [
      "operation",
      "input"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#",
    "examples": [
      {
        "operation": "generateNovelIdea",
        "input": {
          "seedFeatures": [
            1,
            2,
            3
          ],
          "corpus": [
            [
              1,
              2
            ]
          ],
          "mutationScale": 0.1,
          "rng": "Math.random"
        }
      }
    ]
  }
}