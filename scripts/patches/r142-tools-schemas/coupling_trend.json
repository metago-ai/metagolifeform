{
  "name": "coupling_trend",
  "description": "耦生趋势分析。适用：时间序列关系变化。返回趋势方向。（算法 ID: ALG_T1_C_024）",
  "arguments": {
    "type": "object",
    "properties": {
      "timeSeries": {
        "type": "array",
        "description": "时间序列：数字数组 [0.3,0.5,0.7]，或 [{time,score}] 数组",
        "examples": [
          [
            0.3,
            0.5,
            0.7,
            0.9
          ]
        ]
      }
    },
    "required": [
      "timeSeries"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#",
    "examples": [
      {
        "timeSeries": [
          0.3,
          0.5,
          0.7,
          0.9
        ]
      }
    ]
  }
}