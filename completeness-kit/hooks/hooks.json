{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${KIT_ROOT}/hooks/scripts/pre-tool-use-guard.cjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${KIT_ROOT}/hooks/scripts/stop-verify.cjs"
          }
        ]
      }
    ]
  }
}
